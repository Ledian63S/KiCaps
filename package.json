{
  "name": "kicaps",
  "version": "1.2.1",
  "description": "KiCaps — Futures Position Size Calculator",
  "main": "main.js",
  "author": "Ledian Leka",
  "scripts": {
    "build:js": "esbuild src/app.jsx --outfile=app.js --jsx=transform --loader:.jsx=jsx --target=es2020 --charset=utf8",
    "start": "npm run build:js && electron .",
    "build": "npm run build:js && electron-builder --win --publish never",
    "build:mac": "npm run build:js && electron-builder --mac --publish never"
  },
  "build": {
    "appId": "com.kicaps.calculator",
    "productName": "KiCaps",
    "artifactName": "KiCaps-Setup-${version}.${ext}",
    "asar": true,
    "files": [
      "KiCaps.html",
      "app.js",
      "main.js",
      "preload.js",
      "icon.png",
      "lib/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "icon.png",
      "category": "public.app-category.finance",
      "artifactName": "KiCaps-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "@electron/packager": "^20.0.0",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.1"
  }
}
